# =============================================================================
# Isabelle Pool Server — Environment Configuration (EXAMPLE)
# =============================================================================
# Copy to `.env` and adjust (scripts/setup.sh does this for you and generates
# the admin token). docker-compose loads `.env` via env_file.
#
# How it works:
#   Python (server/) reads these via server/app/core/config.py
#   Scala  (server/repl/) reads these via sys.env directly (same variable names)
#   The JVM subprocess inherits the environment from the Python parent process.
# =============================================================================


# -----------------------------------------------------------------------------
# SERVER — Pool, concurrency, and field defaults
# -----------------------------------------------------------------------------
# Max concurrent Isabelle sessions. Each session is 1.5–4 GB resident
# (HOL-Analysis-scale at the top): pool_size × ~4 GB must fit under the
# container mem_limit with headroom for one `isabelle build`.
ISABELLE_POOL_SIZE=3
# Sessions to pre-warm at startup (0 = first request pays creation cost).
ISABELLE_INITIAL_SESSIONS=0
# Seconds before an idle session is evicted.
ISABELLE_IDLE_TIMEOUT=1800

# Reuse sessions keyed by import dependencies (experimental).
ISABELLE_ENABLE_CACHE=false
ISABELLE_MAX_CACHE_SIZE=1

# Include raw proof states in responses (verbose, debugging only).
ISABELLE_SHOW_STATES=false
# Default Isabelle session/heap for new sessions (HOL, HOL-Analysis, ...).
ISABELLE_DEFAULT_FIELD=HOL

ISABELLE_SERVER_HOST=0.0.0.0
ISABELLE_SERVER_PORT=8000


# -----------------------------------------------------------------------------
# SECURITY — Admin console / admin endpoints
# -----------------------------------------------------------------------------
# Token for the admin console (/admin) and admin endpoints
# (GET /api/v1/admin/sessions, force-close of unleased sessions via
# X-Admin-Token). scripts/setup.sh generates a random one. Leave empty to
# disable admin endpoints (console close buttons render "locked").
# Also required (2026-09-22) for the DESTRUCTIVE heap endpoints: DELETE heap,
# DELETE heap image, DELETE heap group. Heap build stays open.
ISABELLE_ADMIN_TOKEN=

# Code-execution policy for client Isar text (commands, verify_chunk,
# PUT /document, bigstep, heap-pool project sources). false = reject `ML`,
# `ML_file`, `setup`, `*_setup`, `oracle`, `*_file`, ... with HTTP 422
# (server/app/core/input_guards.py; comments and string/cartouche bodies are
# ignored, so prose mentioning ML is fine). true = any client can run
# arbitrary code inside the container — only for trusted single-user setups
# whose theories genuinely need ML.
ISABELLE_ALLOW_ML_COMMANDS=false

# Colon-separated directories under which heap-pool `project` dirs may live.
# `isabelle build -d <project>` executes whatever lives there, so the set is
# operator-chosen; anything else is 422. Default: repo mount + user volume.
ISABELLE_HEAP_POOL_ALLOWED_ROOTS=/app:/root/.isabelle


# -----------------------------------------------------------------------------
# MEMORY MANAGEMENT — cgroup admission gate
# -----------------------------------------------------------------------------
# Refuse new sessions above this used-% of the container memory limit...
ISABELLE_ENABLE_MEMORY_MANAGEMENT=true
ISABELLE_MEMORY_PRESSURE_THRESHOLD=80.0
# ...or below this many MB available.
ISABELLE_MEMORY_MIN_AVAILABLE_MB=512
ISABELLE_MEMORY_SESSION_COUNT_LIMIT=20
ISABELLE_MEMORY_GC_TRIGGER_THRESHOLD=90.0
ISABELLE_MEMORY_GC_SLEEP_MS=100
# Assumed total memory when cgroup info is unavailable (non-container runs).
ISABELLE_MEMORY_FALLBACK_SYSTEM_MB=4096

# Hard per-process ML heap cap in MB, written into the Isabelle user settings
# by server/repl/Admin/container_entrypoint.sh (Poly/ML --maxheap). Any poly process —
# REPL session or `isabelle build` child — that exceeds it fails gracefully
# (ML exception) instead of OOM-killing the container. Applies to builds
# immediately; to REPL sessions after a server (re)start.
ISABELLE_ML_MAXHEAP_MB=9216

# JVM heap-shrinking flags — KNOWN DEAD (docs/ISSUES.md Bug 11): nothing in
# the Isabelle toolchain consumes this variable; it never reaches the gateway
# JVM. Kept only so existing .env files don't lose the value silently. To
# actually pass JVM options, they must go into the Isabelle user settings file
# (see server/repl/Admin/container_entrypoint.sh's GC-logging block for the pattern).
ISABELLE_SCALA_JAVA_OPTIONS="-Dpolybank.heap.percent=20 -XX:MaxHeapFreeRatio=30 -XX:MinHeapFreeRatio=10 -XX:-ShrinkHeapInSteps"


# -----------------------------------------------------------------------------
# LEASES — client session ownership
# -----------------------------------------------------------------------------
# Seconds before an abandoned leased session is force-closed. Keep small
# (600 = 10 min) so dead MCP/agent processes cannot hold sessions hostage.
ISABELLE_MAX_LEASE_AGE=600


# -----------------------------------------------------------------------------
# TIMEOUTS — per-operation wall-clock budgets (seconds)
# -----------------------------------------------------------------------------
ISABELLE_TIMEOUT_COMMAND=30.0
ISABELLE_TIMEOUT_BIGSTEP=300.0
ISABELLE_TIMEOUT_PROOF_STATE=30.0
ISABELLE_TIMEOUT_CHECKPOINT_SAVE=30.0
ISABELLE_TIMEOUT_CHECKPOINT_RESTORE=30.0
# Wall budget for creating a session's backend — a wedged gateway fails the
# request with 503 after this instead of hanging (must stay below the Py4J
# read timeout below).
ISABELLE_TIMEOUT_SESSION_CREATE=600.0
# Socket-level read timeout for every Py4J call. Bounds how long a wedged JVM
# (alive but never answering) can pin a worker thread. Must exceed the
# slowest legitimate call (distressed load_document was ~500 s).
ISABELLE_PY4J_READ_TIMEOUT=900.0
# Seconds between background pool cleanup sweeps.
ISABELLE_CLEANUP_INTERVAL=60


# -----------------------------------------------------------------------------
# REPL / Py4J GATEWAY — timings for the Python⟷Scala bridge
# -----------------------------------------------------------------------------
ISABELLE_REPL_SUBGOALS_TIMEOUT=5
ISABELLE_REPL_LOCAL_FACTS_TIMEOUT=20
ISABELLE_REPL_GLOBAL_FACTS_TIMEOUT_MINUTES=5
ISABELLE_REPL_GATEWAY_POLL_INTERVAL=0.1
ISABELLE_REPL_GATEWAY_POLL_TIMEOUT=20.0
ISABELLE_REPL_GATEWAY_TERMINATE_WAIT=3.0
ISABELLE_REPL_SLEDGEHAMMER_TIMEOUT=30
ISABELLE_BACKEND_EXIT_TIMEOUT=60.0
ISABELLE_BACKEND_JOIN_TIMEOUT=5.0
ISABELLE_BACKEND_QUEUE_POLL=0.1
ISABELLE_SERVER_START_RETRIES=5


# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
ISABELLE_SERVER_LOG_LEVEL=INFO
ISABELLE_SERVER_LOG_DIR=logs
ISABELLE_SERVER_LOG_FILE=server.log
ISABELLE_SERVER_MAX_LOG_SIZE_BYTES=10485760
ISABELLE_SERVER_LOG_BACKUP_COUNT=5
ISABELLE_SERVER_ENABLE_FILE_LOGGING=true
ISABELLE_SERVER_REQUEST_ID_HEADER=X-Request-ID
ISABELLE_SERVER_COMMAND_PREVIEW_CHARS=120
ISABELLE_SERVER_THEORY_PREVIEW_CHARS=160
