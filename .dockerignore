# VCS / IDE / build caches that the image never needs. An open Metals/Bloop
# session holds locks in .metals/ and .scala-build/ -> BuildKit "error from
# sender: context canceled", so they are excluded explicitly.
.git/
.gitignore
.metals/
.scala-build/
.bloop/
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
*.egg
.eggs/
build/
dist/
.pytest_cache/
.coverage
htmlcov/
node_modules/

# Runtime state and secrets (the container gets .env via compose env_file)
.env
.env.local
*.log
logs/

# Docker files themselves
Dockerfile
docker-compose.yml
.dockerignore

# Not needed inside the image
archive/
claude-work/
examples/
evaluation/results/
evaluation/MCP-comparison/runs/
docs/
*.pdf
*(temp)/

# Backend build artifacts: the image compiles them itself (isabelle scala_build);
# host copies would mask a broken build and carry stale Gradle output.
server/repl/lib/
server/repl/Admin/lib/
server/repl/build/
server/repl/.gradle/
