# Turnkey export image — the regular image plus the session heaps and Isabelle
# user settings of a running deployment baked in. Fully self-contained: no
# volume, no build steps, no .env — `docker run -p 8000:8000 --memory 14g <tag>`
# serves the API. Produced by deploy/export_turnkey.sh (which also prints the
# recipient runbook; see README "A7. Turnkey image").
#
# Build context is a staging dir holding export_isabelle_home/ — the
# <identifier>/{heaps,etc} (+ heap_pool/) subtree copied out of the live
# isabelle_user_data volume. The contribs and the REPL jar are already in the
# base image layer, so they are not copied again.
#
#   docker build -f deploy/Dockerfile.export \
#     --build-arg BASE_IMAGE=isabelle-pool-server:local \
#     --build-arg GIT_REVISION=$(git rev-parse HEAD) -t isabelle-pool-server:turnkey <staging>

ARG BASE_IMAGE=isabelle-pool-server:local
FROM ${BASE_IMAGE}

ARG GIT_REVISION=unknown
LABEL org.opencontainers.image.revision="${GIT_REVISION}"

# Merged over the image's own /root/.isabelle (contribs + component registration).
COPY export_isabelle_home /root/.isabelle

# Server defaults suited to a 14g container (all overridable with -e at run).
ENV ISABELLE_POOL_SIZE=3 \
    ISABELLE_INITIAL_SESSIONS=0 \
    ISABELLE_ENABLE_MEMORY_MANAGEMENT=true \
    ISABELLE_MEMORY_PRESSURE_THRESHOLD=80.0 \
    ISABELLE_MEMORY_MIN_AVAILABLE_MB=512 \
    ISABELLE_MAX_LEASE_AGE=600 \
    ISABELLE_SERVER_ENABLE_FILE_LOGGING=true

EXPOSE 8000

# Entrypoint: component registration (no-op here) -> settings -> foreground API.
CMD ["bash", "./server/repl/Admin/container_entrypoint.sh"]
