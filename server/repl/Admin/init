#!/usr/bin/env bash
#
# DESCRIPTION: register the Isabelle Pool Server REPL component (server/repl)
# and its py4j/spliff contribs with Isabelle. Idempotent and cheap when already
# done: the container entrypoint runs it on EVERY start, because a pre-existing
# isabelle_user_data volume shadows whatever registration the image build did
# (docs/ISSUES.md Bug 7); deploy/native_setup.sh runs it once on a host.
#
# Layout assumption: this file is <repo>/server/repl/Admin/init; Isabelle is
# $ISABELLE_HOME (default /opt/isabelle, else `isabelle` on PATH). The REPL
# component used to live at <repo>/repl (before 2026-09-27); stale
# registrations of that path are removed here so older volumes migrate.

set -euo pipefail

SCRIPT_DIR="$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )"
REPL_ROOT="$( cd -- "${SCRIPT_DIR}/.." &> /dev/null && pwd )"          # <repo>/server/repl
REPO_ROOT="$( cd -- "${REPL_ROOT}/../.." &> /dev/null && pwd )"        # <repo>

ISABELLE="${ISABELLE_HOME:-/opt/isabelle}/bin/isabelle"
[[ -x "$ISABELLE" ]] || ISABELLE="$(command -v isabelle || true)"
[[ -n "$ISABELLE" ]] || { echo "init: isabelle not found (set ISABELLE_HOME or put it on PATH)" >&2; exit 1; }

fix_settings_tree() {
  local dir="$1"
  [[ -d "$dir" ]] || return 0
  find "$dir" -path '*/etc/settings' -type f -exec sed -i 's/\r$//' {} \;
}

# ISABELLE_COMPONENTS='' so a stale "Bad component" registration cannot break
# the very query that tells us where the registrations live.
ISABELLE_IDENTIFIER="$(ISABELLE_COMPONENTS='' "$ISABELLE" getenv -b ISABELLE_IDENTIFIER)" \
  || { echo "init: '$ISABELLE getenv ISABELLE_IDENTIFIER' failed — is this a working Isabelle installation?" >&2; exit 1; }
CONTRIB_DIR="${HOME}/.isabelle/${ISABELLE_IDENTIFIER}/contrib"
COMPONENTS_FILE="${HOME}/.isabelle/${ISABELLE_IDENTIFIER}/etc/components"

# Fast path (container start on a warm volume): everything registered at the
# CURRENT location and no stale pre-move entry -> nothing to do.
if [[ -f "$COMPONENTS_FILE" ]] \
    && grep -qx "$REPL_ROOT" "$COMPONENTS_FILE" \
    && grep -qx "$REPL_ROOT/Admin" "$COMPONENTS_FILE" \
    && ! grep -qx "$REPO_ROOT/repl" "$COMPONENTS_FILE" \
    && ! grep -qx "$REPO_ROOT/repl/Admin" "$COMPONENTS_FILE" \
    && grep -q "contrib/py4j" "$COMPONENTS_FILE" \
    && grep -q "contrib/spliff" "$COMPONENTS_FILE"; then
  echo "init: components already registered (${ISABELLE_IDENTIFIER}), nothing to do"
  exit 0
fi

# Fix any repo-side settings, then stale user contrib settings, before use.
fix_settings_tree "$REPO_ROOT"
fix_settings_tree "$CONTRIB_DIR"

# Drop registrations of the PRE-MOVE component location (<repo>/repl). A
# registered-but-missing component makes Isabelle fail with "Bad component".
for legacy in "${REPO_ROOT}/repl" "${REPO_ROOT}/repl/Admin"; do
  if [[ -f "$COMPONENTS_FILE" ]] && grep -qx "$legacy" "$COMPONENTS_FILE"; then
    echo "init: removing stale component registration $legacy"
    "$ISABELLE" components -x "$legacy" || true
  fi
done

"$ISABELLE" components -u "$REPL_ROOT/Admin"
# component_py4j/component_spliff fail if the contrib directory already exists,
# so when present we skip the download but still ensure the component is
# REGISTERED (components -u is idempotent).
py4j_dir="$(ls -d "${CONTRIB_DIR}"/py4j* 2>/dev/null | head -1 || true)"
if [[ -n "$py4j_dir" ]]; then
  echo "init: py4j contrib already present, ensuring registration"
  "$ISABELLE" components -u "$py4j_dir"
else
  "$ISABELLE" component_py4j
fi
spliff_dir="$(ls -d "${CONTRIB_DIR}"/spliff* 2>/dev/null | head -1 || true)"
if [[ -n "$spliff_dir" ]]; then
  echo "init: spliff contrib already present, ensuring registration"
  "$ISABELLE" components -u "$spliff_dir"
else
  "$ISABELLE" component_spliff
fi

# IMPORTANT: fix newly created contrib settings again
fix_settings_tree "$CONTRIB_DIR"

"$ISABELLE" components -u "$REPL_ROOT"

echo "init: done. REPL_ROOT=$REPL_ROOT  ISABELLE=$ISABELLE  ID=$ISABELLE_IDENTIFIER"
