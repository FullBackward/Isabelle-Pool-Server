#!/usr/bin/env bash
#
# DESCRIPTION: register the IsabelleGym REPL component (server/repl) and its
# py4j/spliff contribs with Isabelle. Idempotent; safe to re-run on a warm
# isabelle_user_data volume (container_init.sh does exactly that).
#
# Layout assumption (the container): this file is /app/server/repl/Admin/init,
# Isabelle is /opt/isabelle. The REPL component used to live at /app/repl
# (before 2026-09-27); stale registrations of that path are removed here so
# volumes created by older images migrate automatically.

set -euo pipefail

SCRIPT_DIR="$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )"
REPL_ROOT="$( cd -- "${SCRIPT_DIR}/.." &> /dev/null && pwd )"          # /app/server/repl
REPO_ROOT="$( cd -- "${REPL_ROOT}/../.." &> /dev/null && pwd )"        # /app
ISABELLE="${ISABELLE_HOME:-/opt/isabelle}/bin/isabelle"

fix_settings_tree() {
  local dir="$1"
  [[ -d "$dir" ]] || return 0
  find "$dir" -path '*/etc/settings' -type f -exec sed -i 's/\r$//' {} \;
}

ISABELLE_IDENTIFIER="$(ISABELLE_COMPONENTS='' "$ISABELLE" getenv -b ISABELLE_IDENTIFIER 2>/dev/null || echo Isabelle2025-2)"
CONTRIB_DIR="${HOME}/.isabelle/${ISABELLE_IDENTIFIER}/contrib"
COMPONENTS_FILE="${HOME}/.isabelle/${ISABELLE_IDENTIFIER}/etc/components"

# Fix any repo-side settings
fix_settings_tree "$REPO_ROOT"

# Fix stale user contrib settings before using components
fix_settings_tree "$CONTRIB_DIR"

# Drop registrations of the PRE-MOVE component location (/app/repl). A
# registered-but-missing component makes Isabelle fail with "Bad component".
for legacy in "${REPO_ROOT}/repl" "${REPO_ROOT}/repl/Admin"; do
  if [[ -f "$COMPONENTS_FILE" ]] && grep -qx "$legacy" "$COMPONENTS_FILE"; then
    echo "init: removing stale component registration $legacy"
    "$ISABELLE" components -x "$legacy" || true
  fi
done

"$ISABELLE" components -u "$REPL_ROOT/Admin"
# component_py4j/component_spliff fail if the contrib directory already exists,
# so when present we skip the download but still ensure the component is
# REGISTERED (components -u is idempotent) — keeps this script safe to re-run
# on a warm isabelle_user_data volume, e.g. from container_init.sh.
py4j_dir="$(ls -d "${CONTRIB_DIR}"/py4j* 2>/dev/null | head -1 || true)"
if [[ -n "$py4j_dir" ]]; then
  echo "py4j contrib already present, ensuring registration"
  "$ISABELLE" components -u "$py4j_dir"
else
  "$ISABELLE" component_py4j
fi
spliff_dir="$(ls -d "${CONTRIB_DIR}"/spliff* 2>/dev/null | head -1 || true)"
if [[ -n "$spliff_dir" ]]; then
  echo "spliff contrib already present, ensuring registration"
  "$ISABELLE" components -u "$spliff_dir"
else
  "$ISABELLE" component_spliff
fi

# IMPORTANT: fix newly created contrib settings again
fix_settings_tree "$CONTRIB_DIR"

"$ISABELLE" components -u "$REPL_ROOT"

echo "Init done. REPL_ROOT=$REPL_ROOT  ISABELLE=$ISABELLE  ID=$ISABELLE_IDENTIFIER"
